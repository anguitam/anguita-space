---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../lib/paths';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---
<Layout title={`${project.data.title} | Martin Anguita`}>
  <div class="wrap">
    <a class="back-link" href={withBase('/projects')}>&larr; Back to projects</a>
    <header class="post-header">
      <h1 class="post-title">{project.data.title}</h1>
      <div class="post-meta">
        <time datetime={project.data.date.toISOString()}>
          {project.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}
        </time>
        {project.data.tags?.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </div>
</Layout>
