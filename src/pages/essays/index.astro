---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const essays = (await getCollection('essays')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<Layout title="Essays | Martin Anguita">
  <div class="wrap">
    <h1 class="section-title">Essays</h1>
    <ul class="card-list">
      {essays.map((essay) => (
        <li class="card">
          <a class="card-link" href={`/essays/${essay.id}`}>
            <span class="card-title">{essay.data.title}</span>
            <p class="card-desc">{essay.data.description}</p>
            <div class="card-meta">
              <time datetime={essay.data.date.toISOString()}>
                {essay.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}
              </time>
              {essay.data.tags?.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Layout>
