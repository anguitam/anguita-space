---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const essays = await getCollection('essays');
  return essays.map((essay) => ({
    params: { id: essay.id },
    props: { essay },
  }));
}

const { essay } = Astro.props;
const { Content } = await render(essay);
---
<Layout title={`${essay.data.title} | Martin Anguita`}>
  <div class="wrap">
    <a class="back-link" href="/essays">&larr; Back to essays</a>
    <header class="post-header">
      <h1 class="post-title">{essay.data.title}</h1>
      <div class="post-meta">
        <time datetime={essay.data.date.toISOString()}>
          {essay.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}
        </time>
        {essay.data.tags?.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </div>
</Layout>
