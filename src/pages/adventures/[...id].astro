---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const adventures = await getCollection('adventures');
  return adventures.map((adventure) => ({
    params: { id: adventure.id },
    props: { adventure },
  }));
}

const { adventure } = Astro.props;
const { Content } = await render(adventure);
---
<Layout title={`${adventure.data.title} | Martin Anguita`}>
  <div class="wrap">
    <a class="back-link" href="/adventures">&larr; Back to adventures</a>
    <header class="post-header">
      <h1 class="post-title">{adventure.data.title}</h1>
      <div class="post-meta">
        <time datetime={adventure.data.date.toISOString()}>
          {adventure.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}
        </time>
        {adventure.data.tags?.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </div>
</Layout>
