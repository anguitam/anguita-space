---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const adventures = (await getCollection('adventures')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<Layout title="Adventures | Martin Anguita">
  <div class="wrap">
    <h1 class="section-title">Adventures</h1>
    <ul class="card-list">
      {adventures.map((adventure) => (
        <li class="card">
          <a class="card-link" href={`/adventures/${adventure.id}`}>
            <span class="card-title">{adventure.data.title}</span>
            <p class="card-desc">{adventure.data.description}</p>
            <div class="card-meta">
              <time datetime={adventure.data.date.toISOString()}>
                {adventure.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}
              </time>
              {adventure.data.tags?.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Layout>
