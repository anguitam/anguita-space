---
import Layout from '../layouts/Layout.astro';
import { experience, venture, education, focus } from '../data/resume';
import { withBase } from '../lib/paths';
import ResumeItem from '../components/ResumeItem.astro';
---

<Layout title="Martín Raúl Anguita">
  <div class="wrap">
    <section class="about">
      <img class="portrait" src={withBase('/portrait.jpg')} alt="Martín Raúl Anguita" width="480" height="640" style="object-position: center 90%;" />
      <div class="about-body">
        <p class="eyebrow">Hello! You have reached</p>
        <h1 class="hero-title">Martín Anguita</h1>
        <p class="lede">I like taking products from “what if?” to “it works.” My background spans engineering, defense technology, robotics, and industrial automation. I can own the journey from concept to launch, bridging engineering, manufacturing, operations, and business to turn ambitious ideas into products that simply work. I was born in Chile, and was raised ski racing by my coaching father; I competed in 3 world championships while also being on the Dartmouth Ski Team. Now, I focus on backcountry skiing and high-peak missions, such as Mt. Baker and Rainier in the winter, and spearfishing and climbing in the summer. Through all my adventures I have lived in three continents,learned Italian and French on top of my Spanish and English, and make endless friends around the world. I dream of one day sailing around the world, exploring fjords in remote regions where I can ski peaks that no one has ever dreamed of skiing...</p>
        <div class="hero-actions">
          <a class="btn" href={withBase('/projects')}>View projects</a>
          <a class="btn btn-quiet" href="https://www.linkedin.com/in/mart%C3%ADn-r-anguita/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a class="btn btn-quiet" href="mailto:martin.anguita.16@gmail.com">Get in touch</a>
        </div>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title"><span>Summary resume</span></h2>
      <div class="resume-grid">

        <div class="resume-block">
          <h3 class="resume-label">Experience</h3>
          <ol class="resume-list">
            {experience.map((e) => (
              <li><ResumeItem role={e.role} org={e.org} when={e.when} note={e.note} href={e.href} /></li>
            ))}
          </ol>
        </div>

        <div class="resume-block">
          <h3 class="resume-label">Enrepreneurial Ventures</h3>
          <ol class="resume-list">
            {venture.map((e) => (
              <li><ResumeItem role={e.role} org={e.org} when={e.when} note={e.note} href={e.href} /></li>
            ))}
          </ol>
        </div>

        <div class="resume-block">
          <h3 class="resume-label">Education</h3>
          <ol class="resume-list">
            {education.map((e) => (
              <li class="resume-item">
                <p class="resume-role">{e.school}</p>
                <p class="resume-org">{e.major}</p>
                <p class="resume-when">{e.year}</p>
              </li>
            ))}
          </ol>
        </div>

        <div class="resume-block">
          <h3 class="resume-label">Skills</h3>
          <ul class="skill-list">
            {focus.map((s) => <li class="skill">{s}</li>)}
          </ul>
        </div>

      </div>
    </section>

    <section class="section">
      <h2 class="section-title"><span>Contact</span></h2>
      <p>Email: <a href="mailto:martin.anguita.16@gmail.com">martin.anguita.16@gmail.com</a></p>
    </section>
  </div>
</Layout>
